{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weave",
  "version": "0.1.0",
  "identifier": "com.weave.writer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Weave",
      "width": 1280,
      "height": 820,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
